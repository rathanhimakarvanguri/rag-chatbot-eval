# Any OpenAI-compatible endpoint works. Pick one block.

# OpenAI
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Groq (free tier)
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.1-8b-instant

# Local Ollama (no key; run `ollama pull llama3.1:8b` first)
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=
# LLM_MODEL=llama3.1:8b

# API server settings
RAG_RETRIEVER=hybrid
RAG_GENERATOR=extractive
RAG_EMBEDDER=lsa
RAG_MIN_SUPPORT=0.30
